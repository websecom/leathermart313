# Optional storefront branding and canonical URL.
SITE_NAME="LEATHER MART 313"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Clerk authentication. Create an application at https://dashboard.clerk.com
# and copy its publishable and secret keys into .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"

# Comma-separated email addresses allowed to access /admin.
ADMIN_EMAILS=""

# Server-only Backblaze B2 S3-compatible upload credentials.
# B2_PUBLIC_BASE_URL is the public bucket download URL (or a future CDN base URL).
B2_ENDPOINT=""
B2_REGION=""
B2_BUCKET=""
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_PUBLIC_BASE_URL=""

# Server-only Supabase catalog storage and shared admin edit passcode.
# Never prefix the service-role key or passcode with NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Cashfree Payment Gateway ──────────────────────────────────────────────────
# Get these from your Cashfree dashboard: https://merchant.cashfree.com/merchants/login
# Never expose CASHFREE_APP_ID or CASHFREE_SECRET_KEY to the browser (no NEXT_PUBLIC_ prefix).
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
# "sandbox" for testing, "production" for live payments
CASHFREE_ENV="sandbox"
# Exposes the environment to the browser SDK (sandbox | production)
NEXT_PUBLIC_CASHFREE_ENV="sandbox"
# Webhook signing secret — from Cashfree Dashboard → Developers → Webhooks → Secret Key
CASHFREE_WEBHOOK_SECRET=""

# ── Gemini AI Chatbot ──────────────────────────────────────────────────────────
# Get your key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=""
